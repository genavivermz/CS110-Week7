<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="SCREEN CAPTURE / Primary display" FontSize="16" Foreground="#EED19B"/>
    <WrapPanel Margin="0,8">
        <Button Content="_Capture screen" Padding="14,8" Margin="0,0,8,8"/>
        <Button x:Name="SaveCaptureButton" Content="_Save PNG" IsEnabled="False" Padding="14,8" Margin="0,0,8,8"/>
        <Button x:Name="ClearCaptureButton" Content="C_lear" IsEnabled="False" Padding="14,8" Margin="0,0,8,8"/>
    </WrapPanel>
    <Image x:Name="CapturePreview" Height="140" Stretch="Uniform" AutomationProperties.Name="Captured screen preview"/>
  </StackPanel>
</UserControl>
